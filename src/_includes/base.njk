<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if seoTitle %}{{ seoTitle }}{% elif title and page.url != "/" %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} · {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or 'The Stroud Lab at Georgia Tech studies the evolutionary ecology of lizards: natural selection in the wild, thermal physiology, and new technology for eco-evolutionary field studies.' }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

{%- set shareTitle = site.tagline if page.url == "/" else (title or site.title) %}
{%- set shareText = description or site.tagline %}
{%- set shareImage = shareTitle | plain | ogCard(ogImage or hero or photo or "/assets/img/photos/carolinensis-grass.jpg", page.url) %}
<meta property="og:type" content="{{ 'article' if paper else 'website' }}">
{%- if paper %}
{% include "scholar-meta.njk" %}
{%- endif %}
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ (title if page.url != "/" else (seoTitle or site.title)) | plain }}">
<meta property="og:description" content="{{ shareText | plain }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ shareImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ shareTitle | plain }}: {{ site.title }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ (title if page.url != "/" else (seoTitle or site.title)) | plain }}">
<meta name="twitter:description" content="{{ shareText | plain }}">
<meta name="twitter:image" content="{{ site.url }}{{ shareImage }}">
<script type="application/ld+json">{{ schema.graph | jsonld | safe }}</script>

<link rel="icon" href="/assets/img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Karla:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
<script>document.documentElement.className += " js";</script>
</head>
<body>

<header class="masthead">
  <a class="masthead__logo" href="/">
    <img src="/assets/img/stroud-lab-logo-website-header.png"
         alt="{{ site.title }}: {{ site.tagline }}" loading="eager" sizes="480px">
  </a>
</header>

<nav class="navbar" aria-label="Main">
  <div class="navbar__inner">
    <button class="nav__menu" type="button" aria-expanded="false" aria-controls="nav-list">
      <span class="nav__menu-icon" aria-hidden="true"></span>Menu
    </button>
    <ul class="nav__list" id="nav-list">
      {%- for item in nav.main %}
      {%- set active = false %}
      {%- for prefix in item.section %}{% if page.url and page.url.startsWith(prefix) %}{% set active = true %}{% endif %}{% endfor %}
      <li class="nav__item{% if item.children %} nav__item--sub{% endif %}{% if active %} is-active{% endif %}">
        <a class="nav__link" href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
        {%- if item.children %}
        <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="nav-sub-{{ item.id }}">
          <span class="visually-hidden">{{ item.title }} pages</span>
        </button>
        <ul class="nav__sub" id="nav-sub-{{ item.id }}">
          {%- for child in item.children %}
          <li>
            {%- if child.external %}
            <a href="{{ child.url }}" target="_blank" rel="noopener">{{ child.title }}<span class="nav__ext" aria-hidden="true">&#8599;</span><span class="visually-hidden"> (opens in a new tab)</span></a>
            {%- else %}
            <a href="{{ child.url }}"{% if page.url == child.url %} aria-current="page"{% endif %}>{{ child.title }}</a>
            {%- endif %}
          </li>
          {%- endfor %}
        </ul>
        {%- endif %}
      </li>
      {%- endfor %}
    </ul>
  </div>
</nav>

{% if hero %}
<div class="hero">
  <img class="hero__img{% if heroClass %} {{ heroClass }}{% endif %}" src="{{ hero }}" alt="{{ heroAlt or '' }}" loading="eager" fetchpriority="high" sizes="100vw">
</div>
{% endif %}

{% if strapline %}
<p class="strapline">
  {% for part in strapline %}<span>{{ part }}</span>{% if not loop.last %} <b>&bull;</b> {% endif %}{% endfor %}
</p>
{% endif %}

<main>
{{ content | safe }}
</main>

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <h4>The Stroud Lab</h4>
        <p>{{ site.address[0] }}<br>
           {{ site.address[1] }}<br>
           {{ site.address[2] }}<br>
           {{ site.address[3] }}</p>
      </div>
      <div>
        <h4>Contact</h4>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
           <a href="/join/">Prospective students &amp; postdocs</a></p>
      </div>
      <div>
        <h4>Elsewhere</h4>
        <p><a href="/james-stroud/">James Stroud</a><br>
           <a href="{{ site.scholar }}">Google Scholar</a><br>
           {% if site.x %}<a href="{{ site.x }}">X</a><br>{% endif %}
           <a href="{{ site.github }}">GitHub</a><br>
           <a href="/files/Stroud_CV.pdf">Curriculum vitae</a></p>
      </div>
    </div>
    <div class="footer__fine">
      <span>&copy; {{ build.year }} The Stroud Lab. Photographs by Jon Suh and Day&rsquo;s Edge Productions, &copy; their respective authors.</span>
      <span>Georgia Institute of Technology, Atlanta</span>
    </div>
  </div>
</footer>

<div class="lightbox" id="lightbox" hidden>
  <button class="lightbox__close" id="lightbox-close" type="button" aria-label="Close">&times;</button>
  <img class="lightbox__img" id="lightbox-img" src="" alt="" eleventy:ignore>
</div>

<script>
(function () {
  // Label downloads, outbound links and email clicks so the visitor
  // dashboard (/stats/) can count them. Harmless if tracking is off.
  document.querySelectorAll('a[href]').forEach(function (a) {
    var href = a.getAttribute('href') || '';
    if (a.hasAttribute('data-goatcounter-click')) return;
    if (/^mailto:/i.test(href)) {
      a.setAttribute('data-goatcounter-click', 'email/' + href.slice(7).split('?')[0]);
    } else if (/^\/files\//.test(href) || /\.(pdf|zip|csv|xlsx?|docx?)$/i.test(href)) {
      a.setAttribute('data-goatcounter-click', 'download' + (href.charAt(0) === '/' ? '' : '/') + href);
    } else if (/^https?:\/\//i.test(href) && a.hostname !== location.hostname) {
      a.setAttribute('data-goatcounter-click', 'outbound/' + a.hostname.replace(/^www\./, '') + a.pathname);
    }
    if (a.hasAttribute('data-goatcounter-click')) {
      a.setAttribute('data-goatcounter-title', (a.textContent || '').trim().slice(0, 120));
    }
  });
})();

(function () {
  var host = location.hostname;
  document.querySelectorAll('a[href]').forEach(function (a) {
    var href = a.getAttribute('href');
    if (href && /^https?:\/\//i.test(href) && !href.includes(host)) {
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
    }
  });
})();

(function () {
  var lightbox = document.getElementById('lightbox');
  var lightboxImg = document.getElementById('lightbox-img');
  var closeBtn = document.getElementById('lightbox-close');
  var lastFocused = null;

  function openLightbox(img) {
    lastFocused = document.activeElement;
    // Show the largest version the build made, not the one sized for the page.
    var largest = (img.getAttribute('srcset') || '').split(',').pop().trim().split(/\s+/)[0];
    lightboxImg.src = largest || img.currentSrc || img.src;
    lightboxImg.alt = img.alt || '';
    lightbox.hidden = false;
    requestAnimationFrame(function () { lightbox.classList.add('is-open'); });
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(function () {
      lightbox.hidden = true;
      lightboxImg.src = '';
    }, 200);
    if (lastFocused) { lastFocused.focus(); }
  }

  document.querySelectorAll('main img, .hero img').forEach(function (img) {
    img.classList.add('lightbox-trigger');
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', 'View full-resolution photo');
    img.addEventListener('click', function () { openLightbox(img); });
    img.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(img);
      }
    });
  });

  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) { closeLightbox(); }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && lightbox.classList.contains('is-open')) { closeLightbox(); }
  });
})();

(function () {
  document.querySelectorAll('.labpics').forEach(function (el) {
    var imgs = el.querySelectorAll('.labpics__img');
    if (imgs.length < 2) return;
    var prevBtn = el.querySelector('.labpics__nav--prev');
    var nextBtn = el.querySelector('.labpics__nav--next');
    var i = 0;
    var timer = null;

    // Only the showing photo and its two neighbours are displayed, so the
    // browser downloads photos as they come up rather than all at once.
    function mark() {
      Array.prototype.forEach.call(imgs, function (im, k) {
        var near = k === (i + 1) % imgs.length || k === (i - 1 + imgs.length) % imgs.length;
        im.classList.toggle('is-near', near);
      });
    }

    function show(n) {
      var old = imgs[i];
      old.classList.remove('is-active');
      old.classList.add('is-prev');
      setTimeout(function () { old.classList.remove('is-prev'); }, 1100);
      i = (n + imgs.length) % imgs.length;
      imgs[i].classList.add('is-active');
      mark();
    }
    mark();

    function startAuto() {
      timer = setInterval(function () { show(i + 1); }, 4000);
    }

    function restartAuto() {
      if (timer) { clearInterval(timer); }
      startAuto();
    }

    startAuto();

    if (prevBtn && nextBtn) {
      prevBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        show(i - 1);
        restartAuto();
      });
      nextBtn.addEventListener('click', function (e) {
        e.stopPropagation();
        show(i + 1);
        restartAuto();
      });
    }
  });
})();
(function () {
  // Main navigation: the caret buttons open each dropdown for keyboard and
  // touch users (mouse users also get hover, from the CSS), and the Menu
  // button opens the whole list on small screens.
  var nav = document.querySelector('.navbar');
  if (!nav) return;
  var menu = nav.querySelector('.nav__menu');
  var items = nav.querySelectorAll('.nav__item--sub');

  function setOpen(item, open) {
    item.classList.toggle('is-open', open);
    item.querySelector('.nav__toggle').setAttribute('aria-expanded', open ? 'true' : 'false');
  }
  function closeAll(except) {
    items.forEach(function (it) { if (it !== except) setOpen(it, false); });
  }

  items.forEach(function (item) {
    var toggle = item.querySelector('.nav__toggle');
    toggle.addEventListener('click', function () {
      var open = !item.classList.contains('is-open');
      closeAll(item);
      setOpen(item, open);
    });
    item.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && item.classList.contains('is-open')) {
        setOpen(item, false);
        toggle.focus();
        e.stopPropagation();
      }
    });
    item.addEventListener('focusout', function (e) {
      // Clicks outside are handled below; this covers Tab moving focus away.
      if (e.relatedTarget && !item.contains(e.relatedTarget)) setOpen(item, false);
    });
  });

  menu.addEventListener('click', function () {
    var open = !nav.classList.contains('is-open');
    nav.classList.toggle('is-open', open);
    menu.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
  nav.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && nav.classList.contains('is-open') && !nav.querySelector('.nav__item--sub.is-open')) {
      nav.classList.remove('is-open');
      menu.setAttribute('aria-expanded', 'false');
      menu.focus();
    }
  });
  document.addEventListener('click', function (e) {
    if (!nav.contains(e.target)) closeAll();
  });
})();
</script>
{% if site.goatcounter %}
<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
{% endif %}
</body>
</html>
