<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and page.url != "/" %}{{ title }} · {{ site.title }}{% else %}{{ site.title }} · {{ site.tagline }}{% endif %}</title>
<meta name="description" content="{{ description or 'The Stroud Lab at Georgia Tech studies the evolutionary ecology of lizards: natural selection in the wild, thermal physiology, and new technology for eco-evolutionary field studies.' }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<meta property="og:type" content="website">
<meta property="og:title" content="{{ title or site.title }}">
<meta property="og:description" content="{{ description or site.tagline }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}src/assets/img/hero/home.jpg>
<meta name="twitter:card" content="summary_large_image">

<link rel="icon" href="/assets/img/favicon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=Cormorant+Garamond:ital,wght@0,400;1,400&family=Karla:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
</head>
<body>

<header class="masthead">
  <a class="masthead__logo" href="/">
    <img src="/assets/img/stroud-lab-logo-website-header.png"
         alt="{{ site.title }}: {{ site.tagline }}">
  </a>
</header>

<nav class="navbar" aria-label="Main">
  <div class="navbar__inner">
    <ul class="nav__list">
      {%- for item in nav.main %}
      <li><a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a></li>
      {%- endfor %}
    </ul>
<div class="nav-feature">
  {%- for item in nav.feature %}
  <a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>
  {%- endfor %}
  </div>
</div>
</nav>

{% if hero %}
<div class="hero">
  <img class="hero__img{% if heroClass %} {{ heroClass }}{% endif %}" src="{{ hero }}" alt="{{ heroAlt or '' }}">
</div>
{% endif %}

{% if strapline %}
<p class="strapline">
  {% for part in strapline %}<span>{{ part }}</span>{% if not loop.last %} <b>&bull;</b> {% endif %}{% endfor %}
</p>
{% endif %}

<main>
{{ content | safe }}
</main>

<footer class="footer">
  <div class="wrap">
    <div class="footer__grid">
      <div>
        <h4>The Stroud Lab</h4>
        <p>{{ site.address[0] }}<br>
           {{ site.address[1] }}<br>
           {{ site.address[2] }}<br>
           {{ site.address[3] }}</p>
      </div>
      <div>
        <h4>Contact</h4>
        <p><a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
           <a href="/join/">Prospective students &amp; postdocs</a></p>
      </div>
      <div>
        <h4>Elsewhere</h4>
        <p><a href="{{ site.scholar }}">Google Scholar</a><br>
           <a href="{{ site.github }}">GitHub</a><br>
           <a href="/files/Stroud_CV.pdf">Curriculum vitae</a></p>
      </div>
    </div>
    <div class="footer__fine">
      <span>&copy; {{ build.year }} The Stroud Lab. Photographs by Jon Suh and Day&rsquo;s Edge Productions, &copy; their respective authors.</span>
      <span>Georgia Institute of Technology, Atlanta</span>
    </div>
  </div>
</footer>

<div class="lightbox" id="lightbox" hidden>
  <button class="lightbox__close" id="lightbox-close" type="button" aria-label="Close">&times;</button>
  <img class="lightbox__img" id="lightbox-img" src="" alt="">
</div>

<script>
(function () {
  var host = location.hostname;
  document.querySelectorAll('a[href]').forEach(function (a) {
    var href = a.getAttribute('href');
    if (href && /^https?:\/\//i.test(href) && !href.includes(host)) {
      a.setAttribute('target', '_blank');
      a.setAttribute('rel', 'noopener noreferrer');
    }
  });
})();

(function () {
  var lightbox = document.getElementById('lightbox');
  var lightboxImg = document.getElementById('lightbox-img');
  var closeBtn = document.getElementById('lightbox-close');
  var lastFocused = null;

  function openLightbox(img) {
    lastFocused = document.activeElement;
    lightboxImg.src = img.currentSrc || img.src;
    lightboxImg.alt = img.alt || '';
    lightbox.hidden = false;
    requestAnimationFrame(function () { lightbox.classList.add('is-open'); });
    document.body.style.overflow = 'hidden';
    closeBtn.focus();
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    document.body.style.overflow = '';
    setTimeout(function () {
      lightbox.hidden = true;
      lightboxImg.src = '';
    }, 200);
    if (lastFocused) { lastFocused.focus(); }
  }

  document.querySelectorAll('main img, .hero img').forEach(function (img) {
    img.classList.add('lightbox-trigger');
    img.tabIndex = 0;
    img.setAttribute('role', 'button');
    img.setAttribute('aria-label', 'View full-resolution photo');
    img.addEventListener('click', function () { openLightbox(img); });
    img.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(img);
      }
    });
  });

  closeBtn.addEventListener('click', closeLightbox);
  lightbox.addEventListener('click', function (e) {
    if (e.target === lightbox) { closeLightbox(); }
  });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && lightbox.classList.contains('is-open')) { closeLightbox(); }
  });
})();
</script>
</body>
</html>
