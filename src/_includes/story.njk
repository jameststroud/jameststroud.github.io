---
layout: base.njk
---
{#- Layout for a research story. See src/research/*.njk. -#}
<section class="section">
  <div class="wrap-text wrap-text--intro center">
    <p class="eyebrow">Stories from the lab</p>
    <h1>{{ headline | safe }}</h1>
    <p class="lead">{{ lead | safe }}</p>
  </div>
</section>

{%- set coverage = media.stories[page.fileSlug] | byOutletRank(media.outlets) %}

{%- if photo %}
<section class="section--tight">
  <div class="wrap-text">
    <figure>
      <img src="{{ photo }}" alt="{{ photoAlt }}" sizes="(min-width: 60rem) 42rem, 100vw" loading="eager">
      {%- if photoCaption %}<figcaption>{{ photoCaption | safe }}</figcaption>{% endif %}
    </figure>
  </div>
</section>
{%- endif %}

<section class="section--tight">
  <div class="wrap-text story__body">
    {{ content | safe }}

    {%- if coverage.length %}
    <h2 id="in-the-news">In the news</h2>
    <ul class="media-list">
      {%- for m in coverage %}
      <li>
        <span class="media-list__outlet">{{ m.outlet }}</span>
        <a href="{{ m.url }}">{{ m.title }}</a>
        <span class="media-list__meta">{{ m.date | mediaDate }}{% if m.byStroud %} · by James Stroud{% endif %}{% if m.note %} · {{ m.note }}{% endif %}</span>
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}

    {%- set related = papers | papersMatching(relatedPapers) %}
    {%- if related.length %}
    <h2>Read the research</h2>
    <ul class="species__papers">
      {%- for p in related %}
      <li><a href="{{ p.url_page }}">{{ p.title | safe }}</a>. {% if p.journal %}<span class="pub__venue">{{ p.journal | safe }}</span> {% endif %}({{ p.year }})</li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </div>
</section>

<section class="section--tight">
  <div class="wrap-text">
    <aside class="media-contact" aria-labelledby="media-contact-title">
      <h2 id="media-contact-title">Media contact</h2>
      <p class="media-contact__who">
        <strong>James T. Stroud</strong>, Principal Investigator, School of Biological Sciences,
        Georgia Institute of Technology
      </p>
      <p class="media-contact__how">
        <a class="btn btn--accent" href="mailto:{{ site.email }}?subject={{ ('Media request: ' ~ (cardTitle or title)) | urlencode }}">Email {{ site.email }}</a>
      </p>
      {%- if mediaTopics %}
      <p class="media-contact__topics">Available to comment on {{ mediaTopics | safe }}.</p>
      {%- endif %}
      {%- set po = site.pressOffice %}
      {%- if po and po.name %}
      <p class="media-contact__office">
        <span class="media-contact__label">Georgia Tech press office</span>
        <strong>{{ po.name }}</strong>, {{ po.title }}, {{ po.org }}
        {%- if po.email %}<br><a href="mailto:{{ po.email }}">{{ po.email }}</a>{% endif %}
        {%- if po.phone %}{% if po.email %} · {% else %}<br>{% endif %}<a href="tel:{{ po.phone | replace(' ', '') }}">{{ po.phone }}</a>{% endif %}
        {%- if not po.email and not po.phone and po.url %}<br><a href="{{ po.url }}">College of Sciences contact page</a>{% endif %}
      </p>
      {%- endif %}
      {%- if coverage.length %}
      <p class="media-contact__more"><a href="#in-the-news">See previous coverage of this research</a></p>
      {%- endif %}
    </aside>
  </div>
</section>

<section class="section section--band">
  <div class="wrap">
    <h2 class="center">More stories from the lab</h2>
    <div class="cards" style="margin-top:2rem">
      {%- for s in collections.stories %}{% if s.url != page.url %}
      <a class="card species__card" href="{{ s.url }}">
        <p class="card__kicker">Story</p>
        <h3>{{ s.data.cardTitle }}</h3>
        <p>{{ s.data.cardText }}</p>
      </a>
      {%- endif %}{% endfor %}
    </div>
    <p class="center" style="margin-top:2rem"><a class="btn" href="/research/">All of our research</a></p>
  </div>
</section>

<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": headline | plain,
  "description": description,
  "author": { "@id": schema.labId },
  "publisher": { "@id": schema.labId },
  "image": (site.url ~ photo) if photo else undefined,
  "mainEntityOfPage": site.url ~ page.url
} | jsonld | safe }}</script>
